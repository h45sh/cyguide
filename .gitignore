# Bytecode and compilation artifacts
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
.env/

# Packaging and distribution
dist/
build/
*.egg-info/
*.egg
uv.lock

# Testing, coverage, and linting caches
.pytest_cache/
tests/.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
tests/.ruff_cache/
.mypy_cache/
tests/.mypy_cache/
.hypothesis/
tests/.hypothesis/

# Local databases, runtime logs, and data
*.db
*.sqlite3
*.log
logs/
data/
exports/
reports/

# Benchmark temporary previews and historical runs
docs/benchmarks/*.html
!docs/benchmarks/preview.html
docs/benchmarks/*.json
docs/benchmarks/.history/

# Environment configurations and secrets
.env
.env.local

# IDE, editors, and OS metadata
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.config/
.codex
.t3*
.t3-architecture-cache.md

# Agent thread retrospectives (raw retrospectives aggregated into .agents/knowledge/)
.agents/threads/*.md
!.agents/threads/TEMPLATE.md
