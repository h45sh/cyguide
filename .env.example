# CyGuide Environment Variables

# The API provider type.
# Use 'openai' for OpenAI, Groq, OpenRouter, DeepSeek, or any OpenAI-compatible API.
# Use 'anthropic' for Anthropic API.
CYGUIDE_API_TYPE=openai

# The Base URL for the API
# Groq: https://api.groq.com/openai/v1
# OpenAI: https://api.openai.com/v1
# Anthropic: https://api.anthropic.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# Grok: https://api.x.ai/v1
CYGUIDE_API_BASE=https://api.groq.com/openai/v1

# Your API Key (e.g. gsk_...)
CYGUIDE_API_KEY=your_api_key_here

# The model to use
# Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# OpenAI: gpt-4o, gpt-4o-mini
# Anthropic: claude-3-5-sonnet-20240620
# OpenRouter: anthropic/claude-3.5-sonnet, google/gemini-pro-1.5
# Grok: grok-beta
CYGUIDE_API_MODEL=llama-3.3-70b-versatile

# Demo / Video Recording Mode (sanitizes local IP to dummy pentest VPN address: 10.10.14.45 tun0)
# Set to 1, true, or use 'cyg --demo'
CYGUIDE_DEMO=1

